# Copy this file to ".env" (same folder) and fill in what you need.
# .env is ignored by git, so your key never gets committed.

# Needed for the chat panel inside the app (billed per use by Anthropic).
# Create a key at https://console.anthropic.com/ -> API keys.
# Claude Code / Remote Control does NOT need this; it uses your Claude subscription.
ANTHROPIC_API_KEY=

# Optional settings
# A secret every request to the server must carry (recommended with the phone page over Tailscale; 16+ random characters). Then open
# http://localhost:4747/?t=<key> once in each browser, and add "headers": { "Authorization": "Bearer <key>" } to .mcp.json.
# MAPMAKER_ACCESS_TOKEN=
# MAPMAKER_PORT=4747
# MAPMAKER_PROJECTS_DIR=C:\Users\you\Documents\Maps

# Your asset library: a folder of pictures (PNG, JPEG, WebP), .zip files of pictures and asset pack files, in any mix,
# read where they are and never copied.
# (The installed Dragon Drop app sets this in Settings instead.)
# MAPMAKER_ASSETS_DIR=D:\Map Assets

# Phone access through Tailscale (see docs/SETUP-WINDOWS.md, section 7).
# Your PC's Tailscale name, as printed by "tailscale serve". Comma-separate several.
# MAPMAKER_ALLOWED_HOSTS=my-pc.tail1234.ts.net
